# Firebase (public web config — safe to expose in the browser)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server-side AI key, read by api/chat.js (production) and the Vite dev proxy.
# Set this in Vercel → Project → Settings → Environment Variables.
# Never prefix it with VITE_: that would inline it into the browser bundle.
OPENROUTER_API_KEY=""

# Legacy build-time key. Only used as a fallback when the proxy is unavailable.
# Leave it unset in production and rotate any key that was ever shipped.
# VITE_OPENROUTER_API_KEY=""
